# =================================================================
# QUERO - Quadro Universitário de Estágios Remunerados e Oportunidades
# Variáveis de Ambiente
# =================================================================

# Configuração da Aplicação
ENVIRONMENT=development
LOG_LEVEL=info
PROJECT_NAME="QUERO - Quadro Universitário de Estágios Remunerados e Oportunidades"
API_V1_PREFIX=/api/v1

# PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_secret_change_me
POSTGRES_DB=quero_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_secret_change_me@postgres:5432/quero_db

# Autenticação e Segurança (JWT / Mock SSO)
JWT_SECRET_KEY=super_secret_jwt_key_for_development_purposes_only_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
USE_MOCK_AUTH=true

# Armazenamento de Arquivos Local (Volume desacoplado - v5.0 §9)
STORAGE_PATH=./data/documentos
MAX_UPLOAD_SIZE_BYTES=10485760

# CORS
CORS_ORIGINS=*
