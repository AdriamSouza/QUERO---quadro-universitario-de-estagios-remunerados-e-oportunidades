# =================================================================
# QUERO - Quadro Universitário de Estágios Remunerados e Oportunidades
# Variáveis de ambiente (copie para .env e ajuste)
# =================================================================

# Aplicação
ENVIRONMENT=development
LOG_LEVEL=info
API_DOCS_ENABLED=true

# PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_secret_change_me
POSTGRES_DB=quero_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Opcional: tem prioridade sobre as variáveis acima
# DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_secret_change_me@localhost:5432/quero_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SQL_ECHO=false

# Autenticação (JWT). Em produção use uma chave aleatória com 32+ caracteres:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev_only_jwt_secret_change_me_before_deploying_0001
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Senha aplicada na inicialização às contas existentes sem senha (contas da carga inicial).
INITIAL_USERS_PASSWORD=TroqueEstaSenha#2026
ALLOW_STUDENT_SIGNUP=true

# Armazenamento de documentos: "local" (disco) ou "database" (PostgreSQL)
STORAGE_BACKEND=local
STORAGE_PATH=./data/documentos
MAX_UPLOAD_SIZE_BYTES=10485760

# Integração com o sistema acadêmico (opcional). Sem ela, CR e curso são declarados
# pelo estudante e a inscrição aguarda conferência da Pró-Reitoria.
# ACADEMIC_API_URL=https://sistema-academico.exemplo.edu.br/api
# ACADEMIC_API_TOKEN=

# CORS (origens do frontend, separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN_REGEX=
